  moments:
  - situationTitle: Water Served
    situationPrompt: Ravi brings a fresh jug of water to the table.
    fullBodyPoseSprite: {fileID: -1051639420, guid: c7ac4c2cfd2177f4a89d421688bd6011, type: 3}
    propSprite: {fileID: -1330277922, guid: 9ce9ed0c3af73b84daa0659690484f40, type: 3}
    anuReactionSprite: {fileID: -1129723287, guid: ac77abff6ceca544fac6af7927297037, type: 3}
    optionA_Badge: 
    optionA_Text: '"Thank you!"'
    optionA_Outcome: Ravi smiles warmly and nods.
    optionA_VO: VO_U6_ANU_4
    optionA_Clip: {fileID: 8300000, guid: 1e2a48556c35ce74caa8ab1c9facc282, type: 3}
    optionA_Face: 0
    optionA_Avatar: {fileID: 0}
    optionA_RaviPose: {fileID: 0}
    optionB_Badge: 
    optionB_Text: (Say nothing)
    optionB_Outcome: Ravi is polite, but neutral.
    optionB_VO: 
    optionB_Clip: {fileID: 0}
    optionB_Face: 1
    optionB_Avatar: {fileID: 0}
    optionB_RaviPose: {fileID: 0}
  - situationTitle: Calling Ravi
    situationPrompt: Anu needs something and Ravi is across the room.
    fullBodyPoseSprite: {fileID: 1767693086, guid: 05a16462d5b66564380db45baa58f306, type: 3}
    propSprite: {fileID: 0}
    anuReactionSprite: {fileID: -624026220, guid: ac77abff6ceca544fac6af7927297037, type: 3}
    optionA_Badge: 
    optionA_Text: Raise a hand gently and make eye contact
    optionA_Outcome: Ravi notices and comes over calmly.
    optionA_VO: VO_U6_ANU_CALL_POLITE
    optionA_Clip: {fileID: 8300000, guid: 7b89e419cab5430db83c664b1d78248e, type: 3}
    optionA_Face: 0
    optionA_Avatar: {fileID: 0}
    optionA_RaviPose: {fileID: -2091325867, guid: 600da5f794885c34bbc14a02dafeb5ba, type: 3}
    optionB_Badge: 
    optionB_Text: Wave both arms and shout across the room
    optionB_Outcome: Ravi hurries over while other tables look over.
    optionB_VO: VO_U6_ANU_CALL_SHOUT
    optionB_Clip: {fileID: 8300000, guid: faf8ef52810c4fc2b4d3c4199b3c3e28, type: 3}
    optionB_Face: 1
    optionB_Avatar: {fileID: 0}
    optionB_RaviPose: {fileID: 0}
  - situationTitle: Wrong Dish
    situationPrompt: Ravi brings the wrong dish by mistake!
    fullBodyPoseSprite: {fileID: 1508676752, guid: 05a16462d5b66564380db45baa58f306, type: 3}
    propSprite: {fileID: 0}
    anuReactionSprite: {fileID: -1129723287, guid: ac77abff6ceca544fac6af7927297037, type: 3}
    optionA_Badge: 
    optionA_Text: '"Sorry, I think this is the wrong dish."'
    optionA_Outcome: 'Ravi apologises warmly: "I will fix that right away!"'
    optionA_VO: VO_U6_ANU_5
    optionA_Clip: {fileID: 8300000, guid: 048b98a41c53ae14fb91a88768f81959, type: 3}
    optionA_Face: 0
    optionA_Avatar: {fileID: -903311522, guid: ac77abff6ceca544fac6af7927297037, type: 3}
    optionA_RaviPose: {fileID: -1895282525, guid: 600da5f794885c34bbc14a02dafeb5ba, type: 3}
    optionB_Badge: 
    optionB_Text: '"This is WRONG!" (loudly)'
    optionB_Outcome: Ravi apologises stiffly and fixes it quietly.
    optionB_VO: VO_U6_ANU_6
    optionB_Clip: {fileID: 8300000, guid: 538adaf560b41f441abe8a1d49e79cfe, type: 3}
    optionB_Face: 2
    optionB_Avatar: {fileID: 0}
    optionB_RaviPose: {fileID: 0}
  - situationTitle: Food Served
    situationPrompt: Ravi sets the hot dosa down in front of Anu.
    fullBodyPoseSprite: {fileID: 1508676752, guid: 05a16462d5b66564380db45baa58f306, type: 3}
    propSprite: {fileID: 479484706, guid: 0d7b8434e68db0b40af7e965e1c7b687, type: 3}
    anuReactionSprite: {fileID: -1129723287, guid: ac77abff6ceca544fac6af7927297037, type: 3}
    optionA_Badge: 
    optionA_Text: '"Thank you, Ravi!"'
    optionA_Outcome: 'Ravi nods happily: "Enjoy your meal!"'
    optionA_VO: VO_U6_ANU_4
    optionA_Clip: {fileID: 8300000, guid: 1e2a48556c35ce74caa8ab1c9facc282, type: 3}
    optionA_Face: 0
    optionA_Avatar: {fileID: 0}
    optionA_RaviPose: {fileID: 0}
    optionB_Badge: 
    optionB_Text: (Grab fork and eat immediately without looking)
    optionB_Outcome: Ravi steps away quietly.
    optionB_VO: VO_U6_ANU_EAT_FAST
    optionB_Clip: {fileID: 8300000, guid: 0138bcd89c464954b5ef38900fadc3af, type: 3}
    optionB_Face: 1
    optionB_Avatar: {fileID: 0}
    optionB_RaviPose: {fileID: 0}
  - situationTitle: Dropped Fork
    situationPrompt: Anu accidentally drops her fork on the floor.
    fullBodyPoseSprite: {fileID: 1767693086, guid: 05a16462d5b66564380db45baa58f306, type: 3}
    propSprite: {fileID: -403841788, guid: 9ce9ed0c3af73b84daa0659690484f40, type: 3}
    anuReactionSprite: {fileID: -1129723287, guid: ac77abff6ceca544fac6af7927297037, type: 3}
    optionA_Badge: 
    optionA_Text: '"Excuse me, could I have another fork please?"'
    optionA_Outcome: Ravi brings a clean fork right away with a smile.
    optionA_VO: VO_U6_ANU_8
    optionA_Clip: {fileID: 8300000, guid: 651fbec96114c194fbe912facfe1ffd0, type: 3}
    optionA_Face: 0
    optionA_Avatar: {fileID: 0}
    optionA_RaviPose: {fileID: -1802308973, guid: 600da5f794885c34bbc14a02dafeb5ba, type: 3}
    optionB_Badge: 
    optionB_Text: '"I dropped my fork!" (shouted)'
    optionB_Outcome: Ravi brings one while the nearby diners look up.
    optionB_VO: VO_U6_ANU_9
    optionB_Clip: {fileID: 8300000, guid: e393d8f8c178cad4795b461a64d77815, type: 3}
    optionB_Face: 2
    optionB_Avatar: {fileID: 0}
    optionB_RaviPose: {fileID: 0}
